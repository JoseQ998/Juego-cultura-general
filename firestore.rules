rules_version = '2';

// Reglas para Cloud Firestore. Cópialas en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 20;
    }

    function validResult(d) {
      return validName(d.name)
        && d.total is int && d.total >= 1 && d.total <= 20
        && d.score is int && d.score >= 0 && d.score <= d.total * 200
        && d.correct is int && d.correct >= 0 && d.correct <= d.total
        && d.timeMs is int && d.timeMs >= 0 && d.timeMs <= d.total * 10000
        && d.ts is int;
    }

    // Rankings: boards/{modo}/scores/{jugador}
    match /boards/{board}/scores/{player} {
      allow read: if true;
      allow create, update: if validResult(request.resource.data);
      allow delete: if false;
    }

    // Registro de partidas: se puede añadir pero no modificar ni borrar desde la web.
    match /logs/{id} {
      allow read: if true;
      allow create: if validResult(request.resource.data)
        && request.resource.data.tabSwitches is int
        && request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 64
        && request.resource.data.fp is string && request.resource.data.fp.size() <= 64;
      allow update, delete: if false;
    }

    // Salas
    match /lobbies/{code} {
      allow read: if true;
      allow create: if request.resource.data.code == code
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.cats is list && request.resource.data.cats.size() >= 1
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
  }
}
